# Local overrides for the test suite. Copy to .env and edit; never commit .env.
# TestConfig reads this file from the project root. Real environment
# variables and -D system properties always win over values here.
# Every default below targets the public demo APIs only.

# dev or prod (selects config/{env}.properties)
TEST_ENV=dev

# Base URIs
API_BASE_URL=https://jsonplaceholder.typicode.com
HTTPBIN_BASE_URL=https://httpbin.org

# Timeouts in milliseconds
API_CONNECT_TIMEOUT_MS=5000
API_READ_TIMEOUT_MS=10000
API_REQUEST_TIMEOUT_MS=10000

# Dummy demo credentials for httpbin's public /basic-auth endpoint.
# Not real accounts. Replace only with other dummy values.
AUTH_BASIC_USERNAME=user
AUTH_BASIC_PASSWORD=passwd

# Dummy token echoed back by httpbin's public /bearer endpoint. Not a real token.
AUTH_BEARER_TOKEN=sometoken123
